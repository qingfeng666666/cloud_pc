<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.cloudpc.androidslave.permission.MANAGE_LOCAL"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.cloudpc.androidslave.permission.MANAGE_LOCAL" />
    <queries><provider android:authorities="com.cloudpc.management.logs" /></queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="Cloud Android Slave" android:usesCleartextTraffic="false">
        <provider android:name=".ManagementProvider"
            android:authorities="com.cloudpc.androidslave.management"
            android:exported="true"
            android:permission="com.cloudpc.androidslave.permission.MANAGE_LOCAL" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".SlaveService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started Cloud PC slave listener over WireGuard VPN" />
        </service>
        <service android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
