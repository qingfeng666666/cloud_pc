<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.cloudpc.androidslave.permission.MANAGE_LOCAL" />
    <queries><provider android:authorities="com.cloudpc.androidslave.management" /></queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="云电脑管理界面" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:usesCleartextTraffic="true">
        <provider android:name=".RuntimeLogProvider" android:exported="true"
            android:authorities="com.cloudpc.management.logs"
            android:permission="com.cloudpc.androidslave.permission.MANAGE_LOCAL" />
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
